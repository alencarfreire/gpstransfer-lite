<!DOCTYPE html>
<html lang="pt-BR" class="h-full">

<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Transfer Club Med Trancoso, Trancoso, Caraíva, Porto Seguro | GPS Transfer</title>

  <!-- Favicon -->
  <link rel="icon" type="image/svg+xml" href="/favicon.svg">
  <link rel="icon" type="image/png" href="/favicon.png">
  <link rel="shortcut icon" href="/favicon.ico">
  <link rel="apple-touch-icon" href="/favicon.png">

  <!-- SEO Primário -->
  <link rel="canonical" href="https://gpstransfer.com.br/">
  <meta name="description"
    content="A GPS Transfer é especializada em transfer privativo em Porto Seguro para hotéis e pousadas em Trancoso, Caraíva, Arraial d'Ajuda, Club Med, Aeroporto e região. Pontualidade, veículos climatizados e cotação rápida via WhatsApp.">
  <meta name="keywords"
    content="Transfer em Porto Seguro, Transfer Trancoso, Transfer Caraíva, Transfer Aeroporto Porto Seguro, Transfer Arraial d'Ajuda, Transfer Club Med Trancoso, GPS Transfer, Transporte Executivo Porto Seguro">
  <meta name="author" content="Vinícius de Alencar Freire">
  <meta name="robots" content="index, follow, max-snippet:-1, max-image-preview:large, max-video-preview:-1">

  <!-- Geo Tags (Local SEO para Porto Seguro / Bahia) -->
  <meta name="geo.region" content="BR-BA">
  <meta name="geo.placename" content="Porto Seguro">
  <meta name="geo.position" content="-16.4435;-39.0647">
  <meta name="ICBM" content="-16.4435, -39.0647">

  <!-- OpenGraph (Facebook, WhatsApp, LinkedIn) -->
  <meta property="og:type" content="website">
  <meta property="og:locale" content="pt_BR">
  <meta property="og:site_name" content="GPS Transfer">
  <meta property="og:url" content="https://gpstransfer.com.br/">
  <meta property="og:title" content="Transfer Exclusivo em Porto Seguro | GPS Transfer">
  <meta property="og:description"
    content="Evite imprevistos e filas. Seu transfer privativo e pontual em Porto Seguro, Trancoso, Caraíva, Arraial d'Ajuda e Club Med.">
  <meta property="og:image" content="https://i.imgur.com/VyyElng.png">

  <!-- Twitter / X Card -->
  <meta name="twitter:card" content="summary_large_image">
  <meta name="twitter:title" content="GPS Transfer | Transfer Exclusivo em Porto Seguro">
  <meta name="twitter:description"
    content="Transfer privativo e pontual em Porto Seguro, Trancoso, Arraial d'Ajuda, Caraíva e Club Med.">
  <meta name="twitter:image" content="https://i.imgur.com/VyyElng.png">

  <!-- Schema.org JSON-LD para Motores de Busca e Modelos de IA (ChatGPT, Perplexity, Gemini, Google SGE) -->
  <script type="application/ld+json">
  {
    "@context": "https://schema.org",
    "@graph": [
      {
        "@type": "TaxiService",
        "@id": "https://gpstransfer.com.br/#business",
        "name": "GPS Transfer",
        "url": "https://gpstransfer.com.br/",
        "logo": "https://gpstransfer.com.br/favicon.png",
        "image": "https://i.imgur.com/VyyElng.png",
        "description": "Serviço de transfer privativo e executivo  em Porto Seguro, Trancoso, Caraíva, Arraial d'Ajuda, Club Med Trancoso e Santo André.",
        "telephone": "+5573998344769",
        "priceRange": "$$",
        "areaServed": [
          {"@type": "AdministrativeArea", "name": "Porto Seguro"},
          {"@type": "AdministrativeArea", "name": "Trancoso"},
          {"@type": "AdministrativeArea", "name": "Arraial d'Ajuda"},
          {"@type": "AdministrativeArea", "name": "Caraíva"},
          {"@type": "AdministrativeArea", "name": "Club Med Trancoso"},
          {"@type": "AdministrativeArea", "name": "Santo André"},
          {"@type": "AdministrativeArea", "name": "Santa Cruz Cabrália"}
        ],
        "address": {
          "@type": "PostalAddress",
          "addressLocality": "Porto Seguro",
          "addressRegion": "BA",
          "addressCountry": "BR"
        },
        "aggregateRating": {
          "@type": "AggregateRating",
          "ratingValue": "5.0",
          "reviewCount": "120",
          "bestRating": "5"
        },
        "openingHoursSpecification": {
          "@type": "OpeningHoursSpecification",
          "dayOfWeek": [
            "Monday", "Tuesday", "Wednesday", "Thursday", "Friday", "Saturday", "Sunday"
          ],
          "opens": "00:00",
          "closes": "23:59"
        }
      },
      {
        "@type": "FAQPage",
        "@id": "https://gpstransfer.com.br/#faq",
        "mainEntity": [
          {
            "@type": "Question",
            "name": "Por que contratar um transfer de forma antecipada em Porto Seguro?",
            "acceptedAnswer": {
              "@type": "Answer",
              "text": "Contratar o transfer de forma antecipada garante que você será recebido com horário agendado no desembarque do aeroporto, com atendimento exclusivo, tranquilidade e o melhor valor sem pegadinhas."
            }
          },
          {
            "@type": "Question",
            "name": "Como funciona o transfer de Porto Seguro para Trancoso, Caraíva e Arraial d'Ajuda?",
            "acceptedAnswer": {
              "@type": "Answer",
              "text": "A GPS Transfer oferece traslados privativos em veículos executivos e confortáveis diretamente do desembarque do Aeroporto de Porto Seguro para sua pousada ou resort em Trancoso, Caraíva, Arraial d'Ajuda e Club Med."
            }
          },
          {
            "@type": "Question",
            "name": "Como agendar um transfer com a GPS Transfer?",
            "acceptedAnswer": {
              "@type": "Answer",
              "text": "O agendamento é feito de forma rápida pelo WhatsApp oficial (73) 99834-4769. Basta informar a data, horário do voo, destino e quantidade de passageiros para receber a cotação imediata."
            }
          }
        ]
      }
    ]
  }
  </script>

  <!-- Google Tag Manager (Ads & Analytics) -->
  <script>
    (function (w, d, s, l, i) {
      w[l] = w[l] || []; w[l].push({
        'gtm.start':
          new Date().getTime(), event: 'gtm.js'
      }); var f = d.getElementsByTagName(s)[0],
        j = d.createElement(s), dl = l != 'dataLayer' ? '&l=' + l : ''; j.async = true; j.src =
          'https://www.googletagmanager.com/gtm.js?id=' + i + dl; f.parentNode.insertBefore(j, f);
    })(window, document, 'script', 'dataLayer', 'GTM-5ZL5QX3');
  </script>
  <!-- End Google Tag Manager -->

  <!-- Tailwind CSS via CDN -->
  <script src="https://cdn.tailwindcss.com"></script>
  <script>
    tailwind.config = {
      theme: {
        extend: {
          colors: {
            black: '#161616',
            'gray-dark': '#454444',
            'cream-lite': '#F9F8F6',
          }
        }
      }
    }
  </script>

  <!-- Fonte Manrope -->
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Manrope:wght@300;400;500;600;700;800&display=swap"
    rel="stylesheet">

  <style>
    * {
      font-family: 'Manrope', sans-serif;
      -webkit-font-smoothing: antialiased;
      -moz-osx-font-smoothing: grayscale;
      text-rendering: optimizeLegibility;
    }

    @keyframes pulseColors {

      0%,
      100% {
        background-color: #16a34a;
      }

      50% {
        background-color: #166534;
      }
    }

    .animate-pulse-colors {
      animation: pulseColors 3s infinite ease-in-out;
    }
  </style>
</head>

<body class="bg-[#FAFAFA] text-neutral-900 min-h-screen min-h-[100dvh] flex flex-col justify-between overflow-x-hidden">

  <!-- Google Tag Manager (noscript) -->
  <noscript>
    <iframe src="https://www.googletagmanager.com/ns.html?id=GTM-5ZL5QX3" height="0" width="0"
      style="display:none;visibility:hidden"></iframe>
  </noscript>
  <!-- End Google Tag Manager (noscript) -->

  <%= content %>

</body>

</html>