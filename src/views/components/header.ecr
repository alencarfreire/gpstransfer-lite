<div class="w-full max-w-[1440px] mx-auto px-4 sm:px-8 lg:px-[100px] pt-4 sm:pt-6">
  <header class="flex justify-between items-center bg-gradient-to-r from-black via-[#424242] to-black text-[#FAFAFA] py-3.5 sm:py-4 px-6 sm:px-10 rounded-[60px] shadow-xl border border-white/10">
    
    <!-- Brand / Logo -->
    <div class="flex items-center gap-2 font-extrabold text-lg sm:text-xl tracking-tight">
      <span class="text-[#FAFAFA]"><%= @brand_name %></span>
    </div>

    <!-- Navegação Desktop -->
    <nav class="hidden md:block">
      <ul class="flex items-center gap-8 text-sm font-medium text-neutral-300">
        <li><a href="/" class="hover:text-white transition-colors">Home</a></li>
        <li><a href="#destinos" class="hover:text-white transition-colors">Destinos</a></li>
        <li><a href="#contato" class="hover:text-white transition-colors">Contato</a></li>
      </ul>
    </nav>

    <!-- Botão Reservar -->
    <div>
      <a href="<%= @contact.whatsapp_url %>"
         target="_blank"
         rel="noopener noreferrer"
         class="bg-green-600 hover:bg-green-700 transition-colors border-2 border-white text-white text-xs sm:text-sm font-bold px-4 py-2 rounded-full inline-flex items-center gap-2 shadow-sm">
        Reservar
      </a>
    </div>

  </header>
</div>