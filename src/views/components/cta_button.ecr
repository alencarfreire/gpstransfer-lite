<div class="flex flex-col items-center gap-2">
  <div class="flex">
    <a href="<%= @contact.whatsapp_url %>"
       target="_blank"
       rel="noopener noreferrer"
       class="animate-pulse-colors bg-green-600 hover:bg-green-700 text-white px-[22px] py-[14px] rounded-full font-semibold text-base sm:text-lg flex items-center gap-4 cursor-pointer group border-4 border-green-900 shadow-xl transition-all">
      <span><%= @label %></span>
      <svg width="24" height="24" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg" class="group-hover:translate-x-1 transition-all duration-300">
        <path d="M16 19C16 18.258 16.733 17.15 17.475 16.22C18.429 15.02 19.569 13.973 20.876 13.174C21.856 12.575 23.044 12 24 12M24 12C23.044 12 21.855 11.425 20.876 10.826C19.569 10.026 18.429 8.979 17.475 7.781C16.733 6.85 16 5.74 16 5M24 12H0" stroke="white" stroke-width="2"/>
      </svg>
    </a>
  </div>
  <p class="text-[11px] text-[#454444]">
    Você será encaminhado(a) para o nosso <span class="font-bold text-green-700">WhatsApp</span>.
  </p>
</div>
