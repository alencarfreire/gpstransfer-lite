<div
  class="flex-grow flex items-center justify-center w-full max-w-[1440px] mx-auto px-4 sm:px-8 lg:px-[100px] py-6 sm:py-8 my-auto">

  <div class="w-full grid grid-cols-1 md:grid-cols-12 gap-6 lg:gap-12 items-center">

    <!-- Coluna de Texto e Ações (7 colunas a partir do md) -->
    <div class="md:col-span-7 flex flex-col items-center md:items-start text-center md:text-left">

      <!-- Badge TripAdvisor -->
      <div
        class="inline-flex items-center gap-2 bg-neutral-900 text-white text-[11px] sm:text-xs font-semibold px-3 py-1 rounded-full mb-2.5 shadow-sm border border-neutral-800">
        <span class="text-yellow-400">★</span>
        <span>TripAdvisor Travelers' Choice</span>
      </div>

      <!-- Título Principal -->
      <h1
        class="text-3xl sm:text-4xl xl:text-5xl font-extrabold tracking-tight leading-[1.15] text-[#161616] text-balance mb-2.5">
        <%= @title %>
      </h1>

      <!-- Subtítulo -->
      <p class="text-[#454444] text-xs sm:text-base font-medium text-balance mb-3 max-w-xl">
        <%= @subtitle %>
      </p>

      <!-- IMAGEM SUPERIOR: Aparece SOMENTE no mobile (abaixo do md) -->
      <img src="<%= @image_path %>" alt="<%= @title %>" loading="eager"
        class="block md:hidden w-full h-40 sm:h-48 rounded-2xl object-cover object-[25%_60%] shadow-lg border-2 border-white my-3" />

      <!-- Componente de Destinos Dinâmicos -->
      <div class="w-full my-1">
        <%= DestinationComponent.new %>
      </div>

      <!-- Botão CTA WhatsApp -->
      <div class="mt-2.5">
        <%= CtaButtonComponent.new %>
      </div>

    </div>

    <!-- IMAGEM LATERAL: Aparece SOMENTE a partir do md (5 colunas) -->
    <div class="hidden md:flex md:col-span-5 justify-center items-center">
      <div class="w-full max-w-md lg:max-w-none relative group">
        <img src="<%= @image_path %>" alt="<%= @title %>" loading="eager"
          class="w-full h-56 md:h-72 lg:h-[380px] xl:h-[420px] rounded-2xl lg:rounded-3xl object-cover object-[25%_60%] shadow-xl border-2 sm:border-4 border-white transition-transform duration-500 group-hover:scale-[1.01]" />

        <!-- Detalhe flutuante de segurança e pontualidade -->
        <div
          class="hidden md:flex absolute -bottom-3 -left-3 bg-white/95 backdrop-blur-sm border border-neutral-200/80 px-3.5 py-1.5 rounded-full shadow-lg items-center gap-2 text-xs font-semibold text-neutral-800">
          <span class="w-2 h-2 rounded-full bg-emerald-500 animate-ping"></span>
          <span>Transfer Privativo & Pontual</span>
        </div>
      </div>
    </div>

  </div>

</div>